---
import { site } from '../site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return href !== '/' && !href.startsWith('/#') && currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wide-shell site-header-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <svg class="logo-mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
        <circle cx="20" cy="20" r="12.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55" />
        <circle cx="20" cy="20" r="7" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.8" />
        <circle cx="20" cy="20" r="2.4" fill="currentColor" />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Primary navigation" class="site-nav">
      {site.nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle dark and light mode" data-theme-toggle>
      <span aria-hidden="true">●</span>
      <span data-theme-icon>Dark</span>
    </button>
  </div>
</header>
