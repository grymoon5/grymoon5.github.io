---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, site } from '../site.ts';
---

<BaseLayout title={site.title} description={site.description}>
  <main id="top">
    <section class="wide-shell hero" aria-labelledby="hero-title">
      <div class="hero-terminal">
        <div class="terminal-bar">
          <span>PROFILE.SPATIAL</span>
          <span>SG / 01:21N 103:49E</span>
        </div>
        <div class="terminal-content">
          <p class="eyebrow">Full-Stack Engineer (Geospatial) / Community &amp; Programs Lead, WDS / Technical Writer</p>
          <h1 id="hero-title">I build tools people <em>actually</em> use and write about why they work.</h1>
          <p class="hero-sub">
            Case studies, build logs, and career notes from the practical middle of software engineering.
          </p>
          <div class="hero-actions">
            <a href="/case-studies" class="btn btn-primary">Explore case studies</a>
            <a href="#about" class="btn btn-secondary">Profile index</a>
          </div>

          <aside class="focus-card" aria-label="Current focus">
            <p class="section-label"><span class="status-pulse"></span> Current Focus</p>
            <dl>
              <div><dt>Building now</dt><dd>A career platform with JavaScript, CSS, and Supabase.</dd></div>
              <div><dt>Stack</dt><dd>JavaScript, TypeScript, Python, Supabase, QGIS, ETL pipelines, and spatial analysis.</dd></div>
              <div><dt>Writing</dt><dd>Technical content on GIS, Python workflows, and lightweight ETL pipelines for 500+ monthly readers.</dd></div>
              <div><dt>Open to</dt><dd>Full-stack, geospatial, or data engineering roles where I can keep building things people use.</dd></div>
            </dl>
          </aside>
        </div>
      </div>

      <div class="spatial-viewport" data-contour-viewport>
        <canvas data-contour-canvas aria-hidden="true"></canvas>
        <div class="viewport-grid" aria-hidden="true"></div>
        <div class="viewport-header">
          <span>LIVE RELIEF / SINGAPORE</span>
          <span class="viewport-signal">VECTOR ONLINE</span>
        </div>
        <div class="viewport-reticle" aria-hidden="true"><span></span></div>
        <div class="viewport-coordinates">
          <span data-coordinate-lat>01.3521 N</span>
          <span data-coordinate-lng>103.8198 E</span>
          <span>ELEV 42M</span>
        </div>
        <p class="viewport-hint">MOVE CURSOR / READ TERRAIN</p>
      </div>
    </section>

    <div class="wide-shell topo-divider" aria-hidden="true"><span>CONTOUR 042M</span></div>

    <section id="about" class="shell section">
      <p class="section-label">01 / About Me</p>
      <div class="about-grid">
        <div>
          <h2 class="section-title">Hi, I'm Aishwarya.</h2>
          <div class="about-copy">
            <p>
              I'm a full-stack software engineer who builds geospatial and community tools. I work across the stack: front-end (JavaScript, TypeScript), data (Python, ETL pipelines, spatial analysis), and databases (Supabase).
            </p>
            <p>
              From a career platform on JavaScript, CSS and Supabase, to a volunteer task board that lets our volunteers see upcoming events and their tasks at a glance, I enjoy building tools people actually use.
            </p>
            <p>
              Alongside building, I write technical content on geospatial concepts, hands-on projects and career advice. I am also a Community &amp; Programs Lead, leading community and technical initiatives at Women Devs SG.
            </p>
          </div>
        </div>
        <div class="about-portrait">
          <div class="profile-photo">
            <img src={site.profileImage} alt="Illustration of Aishwarya Elango working in geospatial software engineering" />
            <span class="photo-coordinate">COORD / 1.3521 N / 103.8198 E</span>
          </div>
        </div>
      </div>
    </section>

    <section id="writing-series" class="shell section">
      <p class="section-label">02 / Writing Series</p>
      <h2 class="section-title">Choose a series</h2>
      <p class="section-intro">
        Each collection opens on its own page with every published article in that series.
      </p>
      <div class="layer-stack">
        {(['case-studies', 'build-in-public', 'career'] as const).map((slug, index) => (
          <a href={slug === 'career' ? '/career-notes' : `/${slug}`} class="category-card">
            <span class="layer-toggle" aria-hidden="true"></span>
            <span class="layer-index">LAYER {String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{categories[slug].label}</h3>
              <p>{categories[slug].description}</p>
            </div>
            <span class="layer-open" aria-hidden="true">OPEN +</span>
          </a>
        ))}
      </div>
    </section>

    <section id="spotme" class="shell section">
      <p class="section-label">03 / Online Segments</p>
      <h2 class="section-title">#SpotMe</h2>
      <p class="section-intro">
        Talks, panels, workshops, and online sessions I have done.
      </p>
      <div class="spotme-grid">
        {site.spotMe.map((item) => (
          <a href={item.href} class:list={['spotme-card', { 'spotme-card-wide': item.wide }]} target="_blank" rel="noopener">
            <div class="spotme-thumb">
              <img src={item.thumbnail} alt={item.thumbnailAlt} loading="lazy" />
              <span aria-hidden="true">Play</span>
            </div>
            <div class="spotme-meta">
              <span class="spotme-tag">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="contact" class="shell section">
      <div class="contact-panel">
        <div>
          <p class="section-label">04 / Contact</p>
          <h2 class="section-title">Let's Talk</h2>
          <p class="section-intro">
            Open to full-stack, geospatial, data, community tech, and writing conversations.
          </p>
          <div class="socials">
            {site.socials.map((social) => (
              <a class="social-link" href={social.href} target="_blank" rel="noopener">{social.label}</a>
            ))}
          </div>
        </div>
        <a href={`mailto:${site.email}`} class="btn btn-primary">Contact me</a>
      </div>
    </section>
  </main>
  <script>
    const viewport = document.querySelector('[data-contour-viewport]');
    const canvas = document.querySelector('[data-contour-canvas]');

    if (viewport instanceof HTMLElement && canvas instanceof HTMLCanvasElement) {
      const context = canvas.getContext('2d');
      const lat = viewport.querySelector('[data-coordinate-lat]');
      const lng = viewport.querySelector('[data-coordinate-lng]');
      let pointerX = 0.56;
      let pointerY = 0.43;
      let targetX = pointerX;
      let targetY = pointerY;
      let width = 0;
      let height = 0;
      let frame = 0;

      const resize = () => {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        const rect = viewport.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const drawContour = (radius, offset, color, lineWidth) => {
        if (!context) return;
        context.beginPath();
        const points = 180;
        for (let index = 0; index <= points; index += 1) {
          const angle = (index / points) * Math.PI * 2;
          const wave = Math.sin(angle * 3 + offset * 0.35) * 0.075 + Math.cos(angle * 5 - offset * 0.2) * 0.04;
          const rx = radius * (1 + wave) * 1.18;
          const ry = radius * (0.72 + wave * 0.6);
          const x = pointerX * width + Math.cos(angle) * rx;
          const y = pointerY * height + Math.sin(angle) * ry;
          if (index === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.closePath();
        context.strokeStyle = color;
        context.lineWidth = lineWidth;
        context.stroke();
      };

      const render = () => {
        if (!context) return;
        pointerX += (targetX - pointerX) * 0.055;
        pointerY += (targetY - pointerY) * 0.055;
        context.clearRect(0, 0, width, height);

        const styles = getComputedStyle(document.documentElement);
        const copper = styles.getPropertyValue('--copper').trim();
        const olive = styles.getPropertyValue('--olive').trim();
        const base = Math.min(width, height) * 0.095;

        for (let index = 1; index <= 10; index += 1) {
          drawContour(base * index, index, index % 3 === 0 ? olive : copper, index % 3 === 0 ? 1.2 : 0.8);
        }
        frame = requestAnimationFrame(render);
      };

      viewport.addEventListener('pointermove', (event) => {
        const rect = viewport.getBoundingClientRect();
        targetX = (event.clientX - rect.left) / rect.width;
        targetY = (event.clientY - rect.top) / rect.height;
        if (lat) lat.textContent = `${(1.29 + targetY * 0.12).toFixed(4)} N`;
        if (lng) lng.textContent = `${(103.73 + targetX * 0.18).toFixed(4)} E`;
      });

      viewport.addEventListener('pointerleave', () => {
        targetX = 0.56;
        targetY = 0.43;
      });

      new ResizeObserver(resize).observe(viewport);
      resize();
      render();
      document.addEventListener('astro:before-swap', () => cancelAnimationFrame(frame), { once: true });
    }
  </script>
</BaseLayout>
