---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import '../styles.css';

const {
  title,
  description,
  image = site.profileImage,
  pageType = 'website',
  publishedDate,
  modifiedDate,
  schema,
} = Astro.props;
const pageName = title === site.title ? 'Home' : title;
const documentTitle = `${pageName} | ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url).href;
const imageURL = new URL(image, site.url).href;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.title,
      description: site.description,
      publisher: { '@id': `${site.url}/#author` },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#author`,
      name: site.author,
      url: `${site.url}/#about`,
      image: new URL(site.profileImage, site.url).href,
      sameAs: site.socials.map(({ href }) => href).filter((href) => !href.includes('REPLACE_')),
    },
  ],
};
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={documentTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {pageType === 'article' && <meta property="article:author" content={site.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageURL} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      const root = document.documentElement;
      const toggleBtn = document.querySelector('[data-theme-toggle]');
      const icon = document.querySelector('[data-theme-icon]');

      function applyTheme(theme) {
        root.setAttribute('data-theme', theme);
        if (icon) icon.textContent = theme === 'dark' ? 'Midnight' : 'Paper';
      }

      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        applyTheme(savedTheme);
      } else {
        applyTheme('dark');
      }

      toggleBtn?.addEventListener('click', () => {
        const nextTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        applyTheme(nextTheme);
        localStorage.setItem('theme', nextTheme);
      });

      async function updateArticleViews(el) {
        const slug = el.dataset.viewSlug;
        const mode = el.dataset.viewMode ?? 'get';
        const namespace = 'articles-by-aishwarya';
        const endpoint = mode === 'hit' ? 'hit' : 'get';

        try {
          const response = await fetch(`https://api.countapi.xyz/${endpoint}/${namespace}/${slug}`);
          if (!response.ok) throw new Error('view counter failed');
          const data = await response.json();
          el.textContent = `${Number(data.value).toLocaleString()} views`;
        } catch {
          el.textContent = 'views unavailable';
        }
      }

      document.querySelectorAll('[data-view-slug]').forEach(updateArticleViews);
    </script>
  </body>
</html>
